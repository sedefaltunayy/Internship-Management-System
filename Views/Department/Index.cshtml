@model IEnumerable<WebTabanliStajTakipSistemi.Models.Department>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bölümler";
}

<style>
    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .search-input {
        width: 0;
        height: 40px;
        padding: 0;
        padding-left: 10px;
        border: 1px solid transparent;
        border-radius: 20px;
        outline: none;
        transition: all 0.4s ease;
        opacity: 0;
        cursor: pointer;
    }

        .search-input.active {
            width: 250px;
            padding-left: 40px;
            padding-right: 15px;
            opacity: 1;
            border-color: #3b82f6;
            cursor: text;
        }

    .search-btn {
        width: 40px;
        height: 40px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.4s ease;
        position: absolute;
        right: 0;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border: 1px solid #e5e7eb;
    }

        .search-btn.active {
            right: 215px;
            background: transparent;
            border-color: transparent;
            box-shadow: none;
        }

        .search-btn i {
            font-size: 1.2rem;
            color: #6b7280;
        }
</style>

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="m-0"><i class="bi bi-list-ul me-2"></i> Bölüm Listesi</h5>
                <small class="text-white-50">
                    Toplam <strong id="departmentCount">@Model.Count()</strong> bölüm listeleniyor.
                </small>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="search-wrapper">
                    <div class="search-btn" id="searchBtn">
                        <i class="bi bi-search"></i>
                    </div>
                    <input type="text" id="liveSearch" class="search-input" placeholder="Bölüm veya üniversite ara...">
                </div>

                <button type="button" class="btn btn-light btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#bolumEkleModal" title="Yeni Bölüm Ekle">
                    <i class="bi bi-plus-lg text-primary"></i> <span class="text-primary fw-bold">Bölüm Ekle</span>
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="departmentTable">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 150px;">İşlemler</th>
                            <th>Bölüm Adı</th>
                            <th>Bağlı Olduğu Üniversite</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="department-row">
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-warning border-0 me-1"
                                            onclick="editBolum('@item.Id', '@item.Name', '@item.UniversityId')"
                                            data-bs-toggle="tooltip" title="Düzenle">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0"
                                            onclick="confirmDelete('@item.Id', '@item.Name')"
                                            data-bs-toggle="tooltip" title="Sil">
                                        <i class="bi bi-trash3-fill fs-5"></i>
                                    </button>
                                </td>
                                <td class="align-middle fw-semibold text-dark">@item.Name</td>
                                <td class="align-middle text-muted">@(item.University?.Name ?? "Belirtilmemiş")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noResult" class="text-center py-5 d-none">
                <i class="bi bi-search text-muted display-1"></i>
                <p class="mt-3 text-muted">Aradığınız kritere uygun bölüm bulunamadı.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bolumEkleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Yeni Bölüm Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Bölüm Adı</label>
                        <input name="Name" class="form-control form-control-lg" placeholder="Örn: Yazılım Mühendisliği" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Üniversite Seçin</label>
                        <select name="UniversityId" class="form-select form-control-lg" asp-items="ViewBag.UniversityId" required>
                            <option value="">-- Üniversite Seçiniz --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Bölüm Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="editId" name="Id" />
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Bölüm Adı</label>
                        <input id="editName" name="Name" class="form-control form-control-lg" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Üniversite</label>
                        <select id="editUniversityId" name="UniversityId" class="form-select form-control-lg" asp-items="ViewBag.UniversityId" required>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-warning px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-octagon text-danger display-4"></i>
                <h5 class="mt-3">Emin misiniz?</h5>
                <p class="text-muted small"><strong id="deleteItemName" class="text-dark"></strong> bölümü sistemden kaldırılacak.</p>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteId" name="id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">Evet, Sil</button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        function editBolum(id, name, universityId) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editUniversityId').value = universityId;
            var myModal = new bootstrap.Modal(document.getElementById('editModal'));
            myModal.show();
        }

        function confirmDelete(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteItemName').innerText = name;
            var myModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            myModal.show();
        }

        $(document).ready(function () {
            const searchBtn = $('#searchBtn');
            const searchInput = $('#liveSearch');

            searchBtn.on('click', function () {
                searchBtn.toggleClass('active');
                searchInput.toggleClass('active');

                if (searchInput.hasClass('active')) {
                    searchInput.focus();
                } else {
                    searchInput.val('');
                    filterTable('');
                }
            });

            searchInput.on('keyup', function () {
                const value = $(this).val().toLowerCase();
                filterTable(value);
            });

            function filterTable(value) {
                let visibleCount = 0;

                $(".department-row").filter(function () {
                    const match = $(this).text().toLowerCase().indexOf(value) > -1;
                    $(this).toggle(match);
                    if (match) visibleCount++;
                });

                $("#departmentCount").text(visibleCount);

                if (visibleCount === 0) {
                    $("#departmentTable").addClass('d-none');
                    $("#noResult").removeClass('d-none');
                } else {
                    $("#departmentTable").removeClass('d-none');
                    $("#noResult").addClass('d-none');
                }
            }
        });
    </script>
}