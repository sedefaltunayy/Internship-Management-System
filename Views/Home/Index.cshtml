@{
    ViewData["Title"] = "Ana Sayfa";
}

@if (User.IsInRole("Ogrenci"))
{
    <div class="row">
        <div class="col-md-12 mb-4">
            <h3 class="fw-bold text-dark">Hoş Geldin, @User.Identity.Name! 👋</h3>
            <p class="text-muted">Staj sürecini yan menüden veya buradaki özet kartlarından takip edebilirsin.</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card card-modern bg-primary text-white p-3 shadow border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Aktif Staj Durumu</h6>
                        <h4 class="fw-bold mt-2">Onay Bekliyor</h4>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card card-modern bg-success text-white p-3 shadow border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Toplam İş Günü</h6>
                        <h4 class="fw-bold mt-2">20 Gün</h4>
                    </div>
                    <i class="bi bi-calendar-event fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card card-modern bg-info text-white p-3 shadow border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Yazılan Günlük</h6>
                        <h4 class="fw-bold mt-2">0 / 20</h4>
                    </div>
                    <i class="bi bi-pencil-square fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card card-modern p-4 shadow-sm border-0 bg-white">
                <h5 class="fw-bold mb-3 text-dark">Süreç Hatırlatması</h5>
                <div class="alert alert-warning border-0 small d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Bilgilendirme:</strong> Staj başvurunuz henüz akademik danışmanınız tarafından onaylanmamıştır.
                        Onay geldikten sonra <strong>Günlüklerim</strong> sekmesi üzerinden raporlarınızı girmeye başlayabilirsiniz.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Akademisyen"))
{
    <div class="row">
        <div class="col-md-12 mb-4">
            <h3 class="fw-bold text-dark">Sayın @User.Identity.Name, Hoş Geldiniz.</h3>
            <p class="text-muted">Öğrencilerinizin staj başvurularını ve günlüklerini buradan yönetebilirsiniz.</p>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card card-modern border-0 shadow-sm p-4 bg-white text-center">
                <i class="bi bi-person-check fs-1 text-primary mb-3"></i>
                <h5 class="fw-bold">Onay Bekleyen Başvurular</h5>
                <p class="text-muted small">Şu an incelemeniz gereken staj başvuruları bulunmaktadır.</p>
                <a asp-controller="Staj" asp-action="OnayBekleyenler" class="btn btn-primary w-100">Başvuruları İncele</a>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card card-modern border-0 shadow-sm p-4 bg-white text-center">
                <i class="bi bi-journal-check fs-1 text-success mb-3"></i>
                <h5 class="fw-bold">Kontrol Edilecek Günlükler</h5>
                <p class="text-muted small">Öğrencileriniz tarafından gönderilen yeni staj günlüklerini inceleyin.</p>
                <a href="#" class="btn btn-success w-100">Günlüklere Git</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-5 text-center">
        <img src="~/images/welcome.svg" style="width: 200px;" class="mb-4" />
        <h2 class="fw-bold">Staj Takip Sistemine Hoş Geldiniz</h2>
        <p class="text-muted">Yönetim işlemlerine başlamak için lütfen menüyü kullanın.</p>
    </div>
}