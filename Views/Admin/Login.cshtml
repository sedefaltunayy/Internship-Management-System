@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin Giriş - Staj Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f4f7f6;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .admin-login-card {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }

        .admin-icon {
            font-size: 50px;
            color: #1a2236;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="admin-login-card text-center">
        <div class="admin-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h4 class="fw-bold mb-4">Yönetim Paneli</h4>
        <form asp-action="Login" method="post">
            <div class="mb-3 text-start">
                <label class="form-label small fw-bold">Yönetici E-Posta</label>
                <input type="email" name="email" class="form-control" placeholder="admin@staj.com" required>
            </div>
            <div class="mb-4 text-start">
                <label class="form-label small fw-bold">Şifre</label>
                <input type="password" name="sifre" class="form-control" placeholder="••••••••" required>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
            }

            <button type="submit" class="btn btn-dark w-100 py-2 fw-bold shadow">Sisteme Giriş Yap</button>
        </form>
    </div>
</body>
</html>