@model IEnumerable<WebTabanliStajTakipSistemi.Models.Academic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Akademisyen Listesi";
}

<style>
    /* Arama Kutusu Animasyonu */
    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .search-input {
        width: 0;
        height: 40px;
        padding: 0;
        padding-left: 10px;
        border: 1px solid transparent;
        border-radius: 20px;
        outline: none;
        transition: all 0.4s ease;
        opacity: 0;
        cursor: pointer;
    }

        .search-input.active {
            width: 250px;
            padding-left: 40px;
            padding-right: 15px;
            opacity: 1;
            border-color: #3b82f6;
            cursor: text;
        }

    .search-btn {
        width: 40px;
        height: 40px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.4s ease;
        position: absolute;
        right: 0;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border: 1px solid #e5e7eb;
    }

        .search-btn.active {
            right: 215px;
            background: transparent;
            border-color: transparent;
            box-shadow: none;
        }

        .search-btn i {
            font-size: 1.2rem;
            color: #6b7280;
        }

    .role-badge {
        font-size: 11px;
        padding: 5px 10px;
        border-radius: 20px;
    }
</style>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-4 px-4 border-0">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="m-0 fw-bold text-dark"><i class="bi bi-person-badge me-2 text-success"></i> Akademisyen Yönetimi</h4>
                <p class="text-muted small mb-0">Sistemde kayıtlı <strong id="teacherCount">@Model.Count()</strong> akademisyen bulunuyor.</p>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end mt-3 mt-md-0">
                <div class="search-wrapper">
                    <div class="search-btn" id="searchBtn">
                        <i class="bi bi-search"></i>
                    </div>
                    <input type="text" id="liveSearch" class="search-input" placeholder="Akademisyen ismi veya sicil no...">
                </div>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="teacherTable">
                <thead class="bg-light">
                    <tr class="text-muted small text-uppercase">
                        <th class="ps-4">Sicil No</th>
                        <th>Ad Soyad</th>
                        <th>Bölüm</th>
                        <th>Unvan</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="teacher-row">
                            <td class="ps-4 fw-bold">@item.AcademicNumber</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 me-2 d-none d-md-block" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">
                                        @(string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold">@item.FullName</div>
                                        <div class="text-muted" style="font-size: 11px;">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border fw-normal">@(item.Department?.Name ?? "Atanmamış")</span></td>
                            <td>
                                <span class="role-badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                    @(item.Title ?? "Akademisyen")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                    @* Not: Admin yetki kontrollerini AdminController üzerinden yapıyorsanız 
                                       buradaki form aksiyonlarını AdminController metodlarınıza göre revize etmelisiniz. *@

                                    <form asp-action="DeleteUser" asp-route-id="@item.Id" asp-route-type="Academic" method="post" onsubmit="return confirm('Akademisyen kaydı silinecek. Emin misiniz?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-3 border-0" title="Sil">
                                            <i class="bi bi-trash3"></i> Kaldır
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">

                                    <!-- Düzenle butonu -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary px-3 border-0 edit-academic-btn"
                                            data-id="@item.Id"
                                            data-name="@item.FullName"
                                            data-email="@item.Email"
                                            data-number="@item.AcademicNumber"
                                            data-title="@(item.Title ?? "Belirtilmemiş")"
                                            data-department="@(item.Department?.Name ?? "Atanmamış")"
                                            data-issummer="@item.IsSummerInternshipResponsible.ToString().ToLower()">
                                        <i class="bi bi-pencil-square"></i> Düzenle
                                    </button>

                                    <form asp-action="DeleteUser" asp-route-id="@item.Id" asp-route-type="Academic"
                                          method="post" onsubmit="return confirm('Akademisyen kaydı silinecek. Emin misiniz?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-3 border-0">
                                            <i class="bi bi-trash3"></i> Kaldır
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="noResult" class="text-center py-5 d-none">
            <i class="bi bi-person-x text-muted display-1"></i>
            <p class="mt-3 text-muted">Aranan kriterlerde akademisyen bulunamadı.</p>
        </div>
    </div>
</div>


<!-- Akademisyen Düzenle Modal -->
<div class="modal fade" id="editAcademicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-badge me-2 text-success"></i> Akademisyen Düzenle
                    </h5>
                    <p class="text-muted small mb-0" id="modalAcademicSubtitle"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="editAcademicForm" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Bilgi Kartı -->
                    <div class="bg-light rounded-3 p-3 mb-4 small">
                        <div class="row g-2 text-muted">
                            <div class="col-6">
                                <span class="fw-bold text-dark">Sicil No:</span>
                                <span id="modalAcademicNumber"></span>
                            </div>
                            <div class="col-6">
                                <span class="fw-bold text-dark">E-posta:</span>
                                <span id="modalAcademicEmail"></span>
                            </div>
                            <div class="col-6">
                                <span class="fw-bold text-dark">Unvan:</span>
                                <span id="modalAcademicTitle"></span>
                            </div>
                            <div class="col-6">
                                <span class="fw-bold text-dark">Bölüm:</span>
                                <span id="modalAcademicDepartment"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Yaz Stajı Sorumluluğu -->
                    <div class="border rounded-3 p-3" style="border-color: #dbeafe !important; background: #f8fbff;">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="modalIsSummerResponsible"
                                   name="isSummerInternshipResponsible"
                                   value="true" />
                            <label class="form-check-label fw-bold" for="modalIsSummerResponsible">
                                Yaz Stajı Sorumlusu
                            </label>
                        </div>
                        <div class="text-muted small mt-1">
                            Aktif olduğunda bu akademisyen yaz stajı otomatik atama
                            havuzuna dahil edilir. En az öğrenciye sahip olana atama yapılır.
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">
                    İptal
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4"
                        id="saveAcademicBtn">
                    <i class="bi bi-check-lg me-1"></i> Kaydet
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const searchBtn = $('#searchBtn');
            const searchInput = $('#liveSearch');

            searchBtn.on('click', function () {
                searchBtn.toggleClass('active');
                searchInput.toggleClass('active');
                if (searchInput.hasClass('active')) {
                    searchInput.focus();
                } else {
                    searchInput.val('');
                    filterTable('');
                }
            });

            searchInput.on('keyup', function () {
                const value = $(this).val().toLowerCase();
                filterTable(value);
            });

            function filterTable(value) {
                let visibleCount = 0;
                $(".teacher-row").filter(function () {
                    const match = $(this).text().toLowerCase().indexOf(value) > -1;
                    $(this).toggle(match);
                    if (match) visibleCount++;
                });

                $("#teacherCount").text(visibleCount);
                if (visibleCount === 0) {
                    $("#teacherTable").addClass('d-none');
                    $("#noResult").removeClass('d-none');
                } else {
                    $("#teacherTable").removeClass('d-none');
                    $("#noResult").addClass('d-none');
                }
            }

            $('.edit-academic-btn').on('click', function () {
                const id       = $(this).data('id');
                const name     = $(this).data('name');
                const email    = $(this).data('email');
                const number   = $(this).data('number');
                const title    = $(this).data('title');
                const dept     = $(this).data('department');
                const isSummer = $(this).data('issummer') === true
                                 || $(this).data('issummer') === 'true';

                $('#modalAcademicSubtitle').text(name + ' — ' + dept);
                $('#modalAcademicNumber').text(number);
                $('#modalAcademicEmail').text(email);
                $('#modalAcademicTitle').text(title);
                $('#modalAcademicDepartment').text(dept);
                $('#modalIsSummerResponsible').prop('checked', isSummer);

                $('#editAcademicForm').attr('action', '/Admin/EditAcademic/' + id);

                $('#editAcademicModal').modal('show');
            });

            $('#saveAcademicBtn').on('click', function () {
                $('#editAcademicForm').submit();
            });
        });
    </script>
}