@model WebTabanliStajTakipSistemi.Models.Internship
@using WebTabanliStajTakipSistemi.Enums

@{
    Layout = null;

    var student = Model.Student;
    var company = Model.Company;
    var universityName = student?.University?.Name ?? "ÜNİVERSİTE ADI";
    var departmentName = student?.Department?.Name ?? Model.Department ?? "Bölüm Bilgisi";
    var workDayCount = ViewBag.WorkDayCount ?? 0;
    var educationYear = ViewBag.EducationYear ?? "-";

    string GetValue(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Zorunlu Staj Formu</title>

    <style>
        @@page {
            size: A4;
            margin: 12mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #111;
            font-size: 11px;
            margin: 0;
            background: #f3f4f6;
        }

        .print-toolbar {
            max-width: 210mm;
            margin: 18px auto;
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .print-btn, .back-btn {
            border: 0;
            border-radius: 999px;
            padding: 10px 18px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

        .print-btn {
            background: #0f5bd7;
            color: white;
        }

        .back-btn {
            background: white;
            color: #111827;
            border: 1px solid #d1d5db;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 24px;
            background: white;
            padding: 10mm;
            border: 1px solid #ddd;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #111;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }

        .uni {
            font-size: 15px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .faculty {
            font-size: 13px;
            font-weight: 700;
            margin-top: 2px;
        }

        .form-title {
            font-size: 18px;
            font-weight: 900;
            margin-top: 8px;
            letter-spacing: .5px;
        }

        .application-no {
            text-align: right;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .section-title {
            background: #e5e7eb;
            border: 1px solid #111;
            font-weight: 900;
            text-align: center;
            padding: 5px;
            margin-top: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td, th {
            border: 1px solid #111;
            padding: 5px 6px;
            vertical-align: top;
        }

        .label {
            width: 31%;
            font-weight: 700;
            background: #f9fafb;
        }

        .value {
            font-weight: 600;
        }

        .company-title-row {
            display: grid;
            grid-template-columns: 1fr 42mm;
            gap: 8px;
            align-items: stretch;
        }

        .stamp-box {
            border: 1px solid #111;
            min-height: 48mm;
            text-align: center;
            font-weight: 800;
            padding-top: 10px;
        }

        .letter-text {
            border: 1px solid #111;
            padding: 8px;
            line-height: 1.45;
            text-align: justify;
            margin-top: 8px;
        }

        .signature-area {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 12px;
        }

        .signature-box {
            border: 1px solid #111;
            min-height: 38mm;
            padding: 8px;
        }

        .signature-title {
            font-weight: 900;
            text-align: center;
            margin-bottom: 8px;
        }

        .approval-box {
            border: 1px solid #111;
            margin-top: 10px;
            padding: 8px;
            min-height: 34mm;
        }

        .approval-title {
            font-weight: 900;
            text-align: center;
            margin-bottom: 6px;
        }

        .note {
            margin-top: 8px;
            border: 1px solid #111;
            padding: 7px;
            font-size: 10px;
            line-height: 1.35;
        }

        .footer {
            margin-top: 8px;
            text-align: center;
            font-weight: 700;
        }

        @@media print {
            body {
                background: white;
            }

            .print-toolbar {
                display: none;
            }

            .page {
                border: none;
                margin: 0;
                width: auto;
                min-height: auto;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="print-toolbar">
        <a class="back-btn" href="/Internship/Documents/@Model.Id">Geri Dön</a>
        <button class="print-btn" onclick="window.print()">PDF Olarak Kaydet / Yazdır</button>
    </div>

    <div class="page">
        <div class="header">
            <div class="uni">@universityName</div>
            <div class="form-title">ZORUNLU STAJ FORMU</div>
        </div>

        <div class="application-no">
            Başvuru No: @Model.Id
        </div>

        <div class="section-title">ÖĞRENCİNİN NÜFUS KAYIT BİLGİLERİ</div>

        <table>
            <tr>
                <td class="label">T.C. Kimlik No</td>
                <td class="value">@GetValue(student?.IdentityNumber)</td>
                <td class="label">Adı Soyadı</td>
                <td class="value">@GetValue(student?.FullName)</td>
            </tr>
            <tr>
                <td class="label">Baba Adı</td>
                <td class="value">@GetValue(student?.FatherName)</td>
                <td class="label">Ana Adı</td>
                <td class="value">@GetValue(student?.MotherName)</td>
            </tr>
            <tr>
                <td class="label">Doğum Yeri</td>
                <td class="value">@GetValue(student?.BirthPlace)</td>
                <td class="label">Doğum Tarihi</td>
                <td class="value">@(student?.BirthDate != null ? student.BirthDate.Value.ToString("dd.MM.yyyy") : "")</td>
            </tr>
        </table>

        <div class="section-title">ÖĞRENCİNİN BİLGİLERİ</div>

        <table>
            <tr>
                <td class="label">Öğrenci Numarası</td>
                <td class="value">@GetValue(student?.StudentNumber)</td>
                <td class="label">Öğretim Yılı</td>
                <td class="value">@educationYear</td>
            </tr>
            <tr>
                <td class="label">Bölüm / Program</td>
                <td class="value" colspan="3">@departmentName</td>
            </tr>
            <tr>
                <td class="label">Adres</td>
                <td class="value" colspan="3">@GetValue(student?.Address)</td>
            </tr>
            <tr>
                <td class="label">Telefon</td>
                <td class="value">@GetValue(student?.Phone)</td>
                <td class="label">Cep Telefonu</td>
                <td class="value">@GetValue(student?.MobilePhone)</td>
            </tr>
            <tr>
                <td class="label">E-Posta Adresi</td>
                <td class="value" colspan="3">@GetValue(student?.Email)</td>
            </tr>
        </table>

        <div class="section-title">STAJ YAPILAN YERİN BİLGİLERİ</div>

        <div class="company-title-row">
            <div>
                <table>
                    <tr>
                        <td class="label">Firma Adı / Ünvanı</td>
                        <td class="value">@GetValue(company?.Name)</td>
                    </tr>
                    <tr>
                        <td class="label">Adresi</td>
                        <td class="value">
                            @GetValue(company?.Address)
                            @if (!string.IsNullOrWhiteSpace(company?.City?.Name))
                            {
                                <span> @company.City.Name</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(company?.Country?.Name))
                            {
                                <span> / @company.Country.Name</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="label">Üretim / Hizmet Alanı</td>
                        <td class="value">@GetValue(Model.Position)</td>
                    </tr>
                    <tr>
                        <td class="label">Telefon No</td>
                        <td class="value">@GetValue(company?.Phone)</td>
                    </tr>
                    <tr>
                        <td class="label">Web Adresi</td>
                        <td class="value">@GetValue(company?.WebAddress)</td>
                    </tr>
                    <tr>
                        <td class="label">E-Posta Adresi</td>
                        <td class="value">@GetValue(company?.Email)</td>
                    </tr>
                    <tr>
                        <td class="label">Firma Yetkilisi</td>
                        <td class="value">@GetValue(company?.CompanyRepresentative)</td>
                    </tr>
                    <tr>
                        <td class="label">Staj Başlama Tarihi</td>
                        <td class="value">@Model.StartDate.ToString("dd.MM.yyyy")</td>
                    </tr>
                    <tr>
                        <td class="label">Staj Bitiş Tarihi</td>
                        <td class="value">@Model.EndDate.ToString("dd.MM.yyyy")</td>
                    </tr>
                    <tr>
                        <td class="label">Stajın Süresi (İş Günü)</td>
                        <td class="value">@workDayCount</td>
                    </tr>
                </table>
            </div>

            <div class="stamp-box">
                İMZA / KAŞE
            </div>
        </div>

        <div class="letter-text">
            <strong>İlgili Makama,</strong><br /><br />
            @departmentName öğrencilerinin öğrenim süresi sonuna kadar kuruluş ve işletmelerde staj yapma zorunluluğu vardır.
            Aşağıda bilgileri yer alan öğrencimizin stajını belirtilen iş günü süresince kurumunuzda / işletmenizde yapmasında
            göstereceğiniz ilgiye teşekkür eder, çalışmalarınızda başarılar dileriz.
        </div>

        <div class="signature-area">
            <div class="signature-box">
                <div class="signature-title">Öğrencinin İmzası</div>
                Belge üzerindeki bilgilerin doğru olduğunu bildirir, staj yapacağımı taahhüt ederim.
                <br /><br />
                Tarih: .... / .... / 20....
                <br /><br />
                İmza:
            </div>

            <div class="signature-box">
                <div class="signature-title">Firma Onayı</div>
                Yukarıda bilgileri yer alan öğrencinin belirtilen tarihler arasında kurumumuzda staj yapması uygundur.
                <br /><br />
                Yetkili Adı Soyadı:
                <br /><br />
                İmza / Kaşe:
            </div>
        </div>

        <div class="approval-box">
            <div class="approval-title">Bölüm / Program Onayı</div>
            Bu evrak Öğrenci Bilgi Sistemi / Staj Takip Sistemi üzerinden elektronik olarak ön onaylanmıştır.
            <br /><br />
            Akademik Danışman / Staj Sorumlusu:
            <strong>@GetValue(Model.Academic?.FullName)</strong>
            <br /><br />
            Onay Tarihi:
            @(Model.ApplicationApprovedDate != null ? Model.ApplicationApprovedDate.Value.ToString("dd.MM.yyyy") : "")
        </div>

        <div class="note">
            <strong>ÖNEMLİ NOT:</strong>
            Zorunlu Staj Formu, staj başlangıç tarihinden en az 10 gün önce veya staj takviminde belirtilen süreler içerisinde
            eksiksiz doldurularak ilgili birime teslim edilmelidir. Formun firma tarafından imzalanıp kaşelenmiş hali sisteme
            yüklenmelidir. Staj sigorta işlemleri üniversitenin ilgili süreçleri doğrultusunda yürütülür.
        </div>

        <div class="footer">
            @universityName
        </div>
    </div>
</body>
</html>