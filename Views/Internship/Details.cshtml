@model WebTabanliStajTakipSistemi.Models.Internship
@using WebTabanliStajTakipSistemi.Enums

@{
    Layout = User.IsInRole("Academic") ? "_AcademicLayout" : "_StudentLayout";
    ViewData["Title"] = "Staj Detayı";

    var contractFile = Model.InternshipFiles?
        .FirstOrDefault(f => !f.IsDeleted && f.FileType == InternshipFileType.Contract);

    string typeText = Model.Types switch
    {
        InternshipTypes.Summer => "Yaz Stajı",
        InternshipTypes.LongTime => "Uzun Dönem",
        InternshipTypes.Optional => "Gönüllü",
        _ => "Belirsiz"
    };

    string statusText = Model.Status switch
    {
        InternshipStatus.Pending => "Ön Onay Bekliyor",
        InternshipStatus.ApplicationApproved => "Başvuru Ön Onaylandı - Sözleşme Bekleniyor",
        InternshipStatus.ContractUploaded => "Sözleşme Onayı Bekliyor",
        InternshipStatus.Approved => "Staj Onaylandı - Başlangıç Tarihi Bekleniyor",
        InternshipStatus.Ongoing => "Devam Ediyor",
        InternshipStatus.Completed => "Tamamlandı",
        InternshipStatus.Rejected => "Reddedildi",
        _ => Model.Status.ToString()
    };

    string statusClass = Model.Status switch
    {
        InternshipStatus.Pending => "bg-warning text-dark",
        InternshipStatus.ApplicationApproved => "bg-info text-dark",
        InternshipStatus.ContractUploaded => "bg-primary",
        InternshipStatus.Approved => "bg-success",
        InternshipStatus.Ongoing => "bg-success",
        InternshipStatus.Completed => "bg-secondary",
        InternshipStatus.Rejected => "bg-danger",
        _ => "bg-dark"
    };
}

<style>
    .detail-shell {
        background: linear-gradient(180deg, #f6f3ff 0%, #fbfaff 100%);
        border-radius: 30px;
        padding: 24px;
    }

    .detail-hero {
        background: linear-gradient(135deg, #34215d 0%, #6d46d6 55%, #a78bfa 100%);
        color: #fff;
        border-radius: 28px;
        padding: 30px;
        box-shadow: 0 20px 42px rgba(109, 70, 214, 0.22);
        margin-bottom: 24px;
    }

    .detail-card {
        background: rgba(255,255,255,.97);
        border: 1px solid #ece7ff;
        border-radius: 26px;
        box-shadow: 0 12px 30px rgba(31, 41, 55, 0.06);
        padding: 24px;
        height: 100%;
    }

    .detail-card-title {
        font-size: 17px;
        font-weight: 900;
        color: #2f2646;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .detail-icon {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #ede9fe;
        color: #5b21b6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .detail-row {
        padding: 12px 0;
        border-bottom: 1px solid #f2eefc;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        font-size: 12px;
        font-weight: 800;
        color: #8b78b5;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 4px;
    }

    .detail-value {
        font-size: 15px;
        font-weight: 700;
        color: #2f2646;
        word-break: break-word;
    }

    .detail-muted {
        color: #7b6f97;
        font-weight: 600;
    }

    .top-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.2);
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        margin-right: 8px;
        margin-top: 8px;
    }

    .action-btn {
        border-radius: 999px;
        font-weight: 800;
        padding-left: 18px;
        padding-right: 18px;
    }

    .document-item {
        border: 1px solid #ece7ff;
        border-radius: 18px;
        padding: 14px 16px;
        background: #fbfaff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .document-name {
        font-weight: 800;
        color: #2f2646;
    }

    .document-meta {
        font-size: 12px;
        color: #8b78b5;
    }
</style>

<div class="detail-shell">

    <div class="detail-hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="small text-uppercase fw-bold opacity-75 mb-2">Staj Başvuru Detayı</div>
                <h2 class="fw-bold mb-2">@Model.Student?.FullName</h2>
                <div class="opacity-75">
                    @Model.Company?.Name firmasında yapılacak staj başvurusunun ayrıntılı bilgileri.
                </div>

                <div class="mt-3">
                    <span class="top-chip"><i class="bi bi-building"></i> @Model.Company?.Name</span>
                    <span class="top-chip"><i class="bi bi-briefcase"></i> @Model.Position</span>
                    <span class="top-chip"><i class="bi bi-tag"></i> @typeText</span>
                </div>
            </div>

            <div class="text-end">
                <span class="badge @statusClass px-3 py-2 rounded-pill mb-3">
                    @statusText
                </span>

                <div class="d-flex gap-2 flex-wrap justify-content-end">
                    @if (User.IsInRole("Academic"))
                    {
                        <a asp-action="PendingApprovals" class="btn btn-light action-btn">
                            <i class="bi bi-arrow-left me-1"></i> Listeye Dön
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-light action-btn">
                            <i class="bi bi-arrow-left me-1"></i> Stajlarıma Dön
                        </a>
                    }

                    @if (!User.IsInRole("Academic"))
                    {
                        <a asp-action="Documents" asp-route-id="@Model.Id" class="btn btn-outline-light action-btn">
                            <i class="bi bi-folder2-open me-1"></i> Belgeler
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-title">
                    <span class="detail-icon"><i class="bi bi-person-badge"></i></span>
                    Öğrenci Bilgileri
                </div>

                <div class="detail-row">
                    <div class="detail-label">Ad Soyad</div>
                    <div class="detail-value">@Model.Student?.FullName</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">E-Posta</div>
                    <div class="detail-value">@Model.Student?.Email</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Departman</div>
                    <div class="detail-value">@Model.Department</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Akademik Danışman</div>
                    <div class="detail-value">@Model.Academic?.FullName</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-title">
                    <span class="detail-icon"><i class="bi bi-building"></i></span>
                    Firma Bilgileri
                </div>

                <div class="detail-row">
                    <div class="detail-label">Firma Adı</div>
                    <div class="detail-value">@Model.Company?.Name</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Yetkili</div>
                    <div class="detail-value">@(Model.Company?.CompanyRepresentative ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">E-Posta</div>
                    <div class="detail-value">@(Model.Company?.Email ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Telefon</div>
                    <div class="detail-value">@(Model.Company?.Phone ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Web Adresi</div>
                    <div class="detail-value">@(Model.Company?.WebAddress ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Konum</div>
                    <div class="detail-value">
                        @(Model.Company?.City?.Name ?? "Şehir yok")
                        @if (!string.IsNullOrWhiteSpace(Model.Company?.Country?.Name))
                        {
                            <span> / @Model.Company.Country.Name</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Adres</div>
                    <div class="detail-value detail-muted">@(Model.Company?.Address ?? "Belirtilmemiş")</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-title">
                    <span class="detail-icon"><i class="bi bi-calendar-check"></i></span>
                    Staj Bilgileri
                </div>

                <div class="detail-row">
                    <div class="detail-label">Pozisyon</div>
                    <div class="detail-value">@Model.Position</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Staj Türü</div>
                    <div class="detail-value">@typeText</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Başlangıç - Bitiş</div>
                    <div class="detail-value">
                        @Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Durum</div>
                    <div class="detail-value">
                        <span class="badge @statusClass px-3 py-2 rounded-pill">
                            @statusText
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Açıklama</div>
                    <div class="detail-value detail-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Açıklama girilmemiş." : Model.Description)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-title">
                    <span class="detail-icon"><i class="bi bi-person-lines-fill"></i></span>
                    Mentor Bilgileri
                </div>

                <div class="detail-row">
                    <div class="detail-label">Firma Mentoru</div>
                    <div class="detail-value">@(Model.InternshipMentor ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Mentor E-Posta</div>
                    <div class="detail-value">@(Model.InternshipMentorEmail ?? "Belirtilmemiş")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Mentor Telefon</div>
                    <div class="detail-value">@(Model.InternshipMentorPhone ?? "Belirtilmemiş")</div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="detail-card">
                <div class="detail-card-title">
                    <span class="detail-icon"><i class="bi bi-file-earmark-text"></i></span>
                    Belgeler
                </div>

                @if (Model.InternshipFiles != null && Model.InternshipFiles.Any(f => !f.IsDeleted))
                {
                    @foreach (var file in Model.InternshipFiles.Where(f => !f.IsDeleted))
                    {
                        <div class="document-item">
                            <div>
                                <div class="document-name">@file.FileName</div>
                                <div class="document-meta">
                                    Belge Türü: @file.FileType
                                    @if (file.IsSentToAcademic)
                                    {
                                        <span> · Danışmana gönderildi</span>
                                    }
                                </div>
                            </div>

                            <a href="@file.FilePath" target="_blank" class="btn btn-outline-primary rounded-pill fw-bold">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Aç
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">
                        Bu başvuruya ait yüklenmiş belge bulunmuyor.
                    </div>
                }
            </div>
        </div>

        @if (User.IsInRole("Academic"))
        {
            <div class="col-12">
                <div class="detail-card">
                    <div class="detail-card-title">
                        <span class="detail-icon"><i class="bi bi-check2-square"></i></span>
                        Akademisyen İşlemleri
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @if (!Model.IsApplicationApproved && Model.Status != InternshipStatus.Rejected)
                        {
                            <form asp-action="ApproveApplication" asp-controller="Internship" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success action-btn">
                                    <i class="bi bi-check2-circle me-1"></i> Ön Onay Ver
                                </button>
                            </form>
                        }

                        @if (Model.IsApplicationApproved && Model.ContractUploadedDate != null && !Model.IsContractApproved && Model.Status != InternshipStatus.Rejected)
                        {
                            <form asp-action="ApproveContract" asp-controller="Internship" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-primary action-btn">
                                    <i class="bi bi-patch-check me-1"></i> Sözleşmeyi Onayla
                                </button>
                            </form>
                        }

                        @if (Model.Status != InternshipStatus.Rejected && Model.Status != InternshipStatus.Ongoing && Model.Status != InternshipStatus.Completed)
                        {
                            <form asp-action="RejectInternship" asp-controller="Internship" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger action-btn">
                                    <i class="bi bi-x-circle me-1"></i> Reddet
                                </button>
                            </form>
                        }

                        @if (contractFile != null)
                        {
                            <a href="@contractFile.FilePath" target="_blank" class="btn btn-outline-primary action-btn">
                                <i class="bi bi-file-earmark-text me-1"></i> Sözleşmeyi Aç
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>