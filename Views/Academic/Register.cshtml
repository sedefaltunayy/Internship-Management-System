@model WebTabanliStajTakipSistemi.Models.Academic

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akademisyen Kaydı - Staj Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: radial-gradient(circle at center, #1a2a3a 0%, #0a0f14 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            color: white;
            margin: 0;
            padding: 20px 0;
        }

        .register-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            color: #333;
            text-align: center;
        }

        .portal-title {
            font-weight: 800;
            font-size: 28px;
            color: #1a2a3a;
            margin-bottom: 5px;
        }

        .role-selector {
            background: #f4f7f6;
            border-radius: 50px;
            padding: 5px;
            display: flex;
            margin-bottom: 25px;
        }

        .role-btn {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.3s;
            color: #888;
            background: transparent;
            cursor: pointer;
            text-decoration: none;
        }

            .role-btn.active {
                background: #2b82fb !important;
                color: white !important;
                box-shadow: 0 2px 10px rgba(43, 130, 251, 0.3);
            }

        .form-label {
            display: block;
            text-align: left;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 8px;
            color: #555;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ddd;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .btn-register {
            background: #2b82fb;
            border: none;
            padding: 12px;
            font-weight: 700;
            border-radius: 8px;
            width: 100%;
            color: white;
            transition: 0.3s;
            margin-top: 10px;
        }

            .btn-register:hover {
                background: #1a6ada;
                transform: translateY(-1px);
            }

        .text-danger.small {
            display: block;
            text-align: left;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="register-card shadow-lg">
        <div class="portal-title">Yeni Hesap Oluştur</div>
        <p class="text-muted small">Akademisyen Kayıt Formu</p>

        <div class="role-selector shadow-sm">
            <a asp-controller="Student" asp-action="Register" class="role-btn">Öğrenci</a>
            <a href="#" class="role-btn active">Öğretim Elemanı</a>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-start"></div>

            <div class="row">
                <div class="col-md-6 text-start">
                    <label asp-for="AcademicNumber" class="form-label">Sicil Numarası</label>
                    <input asp-for="AcademicNumber" class="form-control" placeholder="Örn: 12345" required />
                    <span asp-validation-for="AcademicNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6 text-start">
                    <label asp-for="Title" class="form-label">Unvan</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Dr. Öğr. Üyesi" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
            </div>

            <div class="text-start">
                <label asp-for="FullName" class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control" placeholder="Adınız ve Soyadınız" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="text-start">
                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@isubu.edu.tr" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="text-start">
                <label asp-for="Password" class="form-label">Parola</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 text-start">
                    <label asp-for="UniversityId" class="form-label text-primary">Üniversite</label>
                    <select asp-for="UniversityId" class="form-select" asp-items="ViewBag.Universities" required>
                        <option value="">Üniversite Seçiniz</option>
                    </select>
                    <span asp-validation-for="UniversityId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 text-start">
                    <label asp-for="DepartmentId" class="form-label text-primary">Bölüm</label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                        <option value="">Bölüm Seçiniz</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-register">Kaydı Tamamla</button>
        </form>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>