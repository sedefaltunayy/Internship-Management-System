@model IEnumerable<WebTabanliStajTakipSistemi.Models.Internship>
@using WebTabanliStajTakipSistemi.Enums

@{
    Layout = "_AcademicLayout";
    ViewData["Title"] = "Aktif Stajlar";
}

@functions {
    string GetTypeText(InternshipTypes type)
    {
        return type switch
        {
            InternshipTypes.Summer => "Yaz Stajı",
            InternshipTypes.LongTime => "Uzun Dönem",
            InternshipTypes.Optional => "Gönüllü",
            _ => "Belirsiz"
        };
    }
}

<style>
    .active-shell {
        background: linear-gradient(180deg, #f6f3ff 0%, #fbfaff 100%);
        border-radius: 30px;
        padding: 24px;
    }

    .active-hero {
        background: linear-gradient(135deg, #2c7a58 0%, #10b981 55%, #6ee7b7 100%);
        color: #fff;
        border-radius: 28px;
        padding: 30px;
        box-shadow: 0 20px 42px rgba(16, 185, 129, 0.20);
        margin-bottom: 24px;
    }

    .internship-card {
        background: rgba(255,255,255,.97);
        border: 1px solid #e6fff4;
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(31, 41, 55, 0.06);
        padding: 22px;
        height: 100%;
    }

    .mini-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #0f766e;
        font-size: 12px;
        font-weight: 700;
        margin-right: 8px;
        margin-bottom: 8px;
    }
</style>

<div class="active-shell">
    <div class="active-hero">
        <div class="small text-uppercase fw-bold opacity-75 mb-2">Aktif Staj İzleme</div>
        <h2 class="fw-bold mb-2">Devam Eden Stajlar</h2>
        <div class="opacity-75">
            Şu anda devam eden staj kayıtlarını, firma ve öğrenci bilgileriyle birlikte buradan takip edebilirsin.
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-6">
                    <div class="internship-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">@item.Student?.FullName</h5>
                                <div class="text-muted small">@item.Student?.Email</div>
                            </div>
                            <span class="badge bg-success rounded-pill px-3 py-2">Aktif</span>
                        </div>

                        <div class="mb-3">
                            <span class="mini-chip"><i class="bi bi-building"></i> @item.Company?.Name</span>
                            <span class="mini-chip"><i class="bi bi-briefcase"></i> @item.Position</span>
                            <span class="mini-chip"><i class="bi bi-tag"></i> @GetTypeText(item.Types)</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <div class="small text-muted">Başlangıç</div>
                                <div class="fw-bold">@item.StartDate.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Bitiş</div>
                                <div class="fw-bold">@item.EndDate.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Mentor</div>
                                <div class="fw-bold">@item.InternshipMentor</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Mentor Telefon</div>
                                <div class="fw-bold">@item.InternshipMentorPhone</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="mt-3 pt-3 border-top">
                                <div class="small text-muted mb-1">Açıklama</div>
                                <div>@item.Description</div>
                            </div>
                        }

                        <div class="mt-3 pt-3 border-top d-flex gap-2 flex-wrap">
                            <a asp-controller="InternshipDiary" asp-action="Index"
                               asp-route-internshipId="@item.Id"
                               class="btn btn-sm btn-outline-success rounded-pill px-3">
                                <i class="bi bi-journal-richtext me-1"></i> Staj Defteri
                            </a>
                            <a asp-controller="Internship" asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-info-circle me-1"></i> Detay
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="internship-card text-center py-5 text-muted">
                    <i class="bi bi-briefcase display-4 d-block mb-3 text-success"></i>
                    Şu anda aktif staj bulunmuyor.
                </div>
            </div>
        }
    </div>
</div>