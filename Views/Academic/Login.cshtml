@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akademisyen Girişi - Staj Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: radial-gradient(circle at center, #1a2a3a 0%, #0a0f14 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            color: white;
            margin: 0;
        }

        .login-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            color: #333;
            text-align: center;
        }

        .portal-title {
            font-weight: 800;
            font-size: 28px;
            color: #2b82fb;
            margin-bottom: 25px;
        }

        .role-nav {
            background: #f4f7f6;
            border-radius: 50px;
            padding: 5px;
            display: flex;
            margin-bottom: 25px;
        }

        .role-btn {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.3s;
            color: #888;
            background: transparent;
            cursor: pointer;
            text-decoration: none;
        }

            .role-btn.active {
                background: #2b82fb !important;
                color: white !important;
                box-shadow: 0 2px 10px rgba(43, 130, 251, 0.3);
            }

        .form-label {
            display: block;
            text-align: left;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 8px;
            color: #555;
        }

        .form-control {
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ddd;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .btn-login {
            background: #2b82fb;
            border: none;
            padding: 12px;
            font-weight: 700;
            border-radius: 8px;
            width: 100%;
            color: white;
            transition: 0.3s;
            cursor: pointer;
        }

            .btn-login:hover {
                background: #1a6ada;
                transform: translateY(-1px);
            }
    </style>
</head>
<body>
    <div class="login-card shadow-lg">
        <div class="portal-title">Staj Takip Sistemi</div>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger small py-2">@ViewBag.Hata</div>
        }

        <div class="role-nav shadow-sm">
            <a asp-controller="Student" asp-action="Login" class="role-btn">Öğrenci</a>
            <a href="#" class="role-btn active">Öğretim Elemanı</a>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <label class="form-label text-dark">Sicil Numarası</label>
            <input type="text" name="academicNumber" class="form-control shadow-sm" placeholder="Sicil numaranızı giriniz" required>

            <label class="form-label text-dark">Parola</label>
            <input type="password" name="password" class="form-control shadow-sm" placeholder="••••••••" required>

            <button type="submit" class="btn btn-login shadow">Giriş Yap</button>
        </form>

        <div class="mt-4 small">
            <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #2b82fb;">Akademisyen Kaydı</a>
        </div>
    </div>
</body>
</html>