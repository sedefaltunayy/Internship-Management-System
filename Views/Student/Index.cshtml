@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Anasayfa";
}

<div class="row g-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">Başvuru Durumu</h6>
                        <h4 class="fw-bold mb-0 text-primary">@ViewBag.BasvuruDurumu</h4>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-briefcase-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">Staj Türü</h6>
                        <h4 class="fw-bold mb-0 text-info">@ViewBag.StajTuru</h4>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                        <i class="bi bi-tags-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">Belge Durumu</h6>
                        <h4 class="fw-bold mb-0 text-success">@ViewBag.BelgeDurumu</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-file-earmark-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">Staj Defteri</h6>
                        <h4 class="fw-bold mb-0 text-warning">@ViewBag.DefterDurumu</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-journal-richtext fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold text-dark">
                    <i class="bi bi-person-circle me-2 text-primary"></i> Hoş Geldin
                </h6>
            </div>
            <div class="card-body">
                <h5 class="fw-bold">@User.Identity?.Name</h5>
                <p class="text-muted mb-0">
                    Bu panel üzerinden staj başvuru işlemlerini, belgelerini, staj defterini ve hesap bilgilerini yönetebilirsin.
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold text-dark">
                    <i class="bi bi-building me-2 text-success"></i> Son Staj Bilgisi
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">Firma</div>
                        <div class="fw-semibold">@ViewBag.CompanyName</div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Pozisyon</div>
                        <div class="fw-semibold">@ViewBag.Position</div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Başlangıç Tarihi</div>
                        <div class="fw-semibold">
                            @(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("dd.MM.yyyy") : "-")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Bitiş Tarihi</div>
                        <div class="fw-semibold">
                            @(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("dd.MM.yyyy") : "-")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold text-dark">
                    <i class="bi bi-lightning-charge-fill me-2 text-warning"></i> Hızlı İşlemler
                </h6>
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="Internship" asp-action="Index" class="btn btn-primary rounded-pill px-3">
                    Başvuru İşlemleri
                </a>
                <a asp-controller="Internship" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
                    Belgeler
                </a>
                <a asp-controller="Student" asp-action="Notebook" class="btn btn-outline-secondary rounded-pill px-3">
                    Staj Defteri
                </a>
                <a asp-controller="Student" asp-action="Profile" class="btn btn-outline-dark rounded-pill px-3">
                    Profilim
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold text-dark">
                    <i class="bi bi-info-circle-fill me-2 text-info"></i> Genel Bilgiler
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="small text-muted">Üniversite</div>
                    <div class="fw-semibold">@ViewBag.UniversityName</div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted">Bölüm</div>
                    <div class="fw-semibold">@ViewBag.DepartmentName</div>
                </div>

                <div>
                    <div class="small text-muted">Öğrenci Numarası</div>
                    <div class="fw-semibold">@ViewBag.StudentNumber</div>
                </div>
            </div>
        </div>
    </div>
</div>