@model WebTabanliStajTakipSistemi.Models.Student
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = null;

    IEnumerable<SelectListItem> universityItems =
        ViewBag.UniversityId as IEnumerable<SelectListItem> ?? new List<SelectListItem>();

    IEnumerable<SelectListItem> departmentItems =
        ViewBag.DepartmentId as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Öğrenci Kayıt - Staj Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: radial-gradient(circle at center, #1a2a3a 0%, #0a0f14 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            color: white;
            margin: 0;
            padding: 20px 0;
        }

        .login-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 550px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            color: #333;
            text-align: center;
        }

        .portal-title {
            font-weight: 800;
            font-size: 28px;
            color: #2b82fb;
            margin-bottom: 8px;
        }

        .sub-text {
            color: #888;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .role-nav {
            background: #f4f7f6;
            border-radius: 50px;
            padding: 5px;
            display: flex;
            margin-bottom: 25px;
        }

        .role-btn {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.3s;
            color: #888;
            background: transparent;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

            .role-btn.active {
                background: #2b82fb !important;
                color: white !important;
                box-shadow: 0 2px 10px rgba(43, 130, 251, 0.3);
            }

        .form-label {
            display: block;
            text-align: left;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 8px;
            color: #555;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ddd;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .field-block {
            margin-bottom: 14px;
        }

        .btn-login {
            background: #2b82fb;
            border: none;
            padding: 12px;
            font-weight: 700;
            border-radius: 8px;
            width: 100%;
            color: white;
            transition: 0.3s;
            cursor: pointer;
            margin-top: 8px;
        }

            .btn-login:hover {
                background: #1a6ada;
                transform: translateY(-1px);
            }

        .validation-message {
            display: block;
            text-align: left;
            font-size: 12px;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <div class="login-card shadow-lg">
        <div class="portal-title">Staj Takip Sistemi</div>
        <div class="sub-text">Öğrenci Kayıt Formu</div>

        <div class="role-nav shadow-sm">
            <a asp-controller="Student" asp-action="Register" class="role-btn active">Öğrenci</a>
            <a asp-controller="Academic" asp-action="Register" class="role-btn">Öğretim Elemanı</a>
        </div>

        <form asp-controller="Student" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger small text-start mb-3"></div>

            <div class="field-block">
                <label asp-for="StudentNumber" class="form-label">Öğrenci Numarası</label>
                <input asp-for="StudentNumber" class="form-control" placeholder="Örn: 2212729004" required />
                <span asp-validation-for="StudentNumber" class="text-danger validation-message"></span>
            </div>

            <div class="field-block">
                <label asp-for="FullName" class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control" placeholder="Adınız ve Soyadınız" required />
                <span asp-validation-for="FullName" class="text-danger validation-message"></span>
            </div>

            <div class="field-block">
                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@isubu.edu.tr" required />
                <span asp-validation-for="Email" class="text-danger validation-message"></span>
            </div>

            <div class="field-block">
                <label asp-for="Password" class="form-label">Parola</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger validation-message"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="field-block">
                        <label asp-for="UniversityId" class="form-label">Üniversite</label>
                        <select asp-for="UniversityId" class="form-select" asp-items="universityItems" required>
                            <option value="">Üniversite Seçiniz</option>
                        </select>
                        <span asp-validation-for="UniversityId" class="text-danger validation-message"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="field-block">
                        <label asp-for="DepartmentId" class="form-label">Bölüm</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="departmentItems" required>
                            <option value="">Bölüm Seçiniz</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger validation-message"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-login shadow">
                <i class="bi bi-person-plus-fill me-2"></i> Kayıt Ol
            </button>
        </form>

        <div class="mt-4 small">
            <a asp-controller="Student" asp-action="Login" class="text-decoration-none fw-bold" style="color: #2b82fb;">
                Zaten hesabın var mı? Giriş Yap
            </a>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>