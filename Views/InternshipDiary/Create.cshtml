@model WebTabanliStajTakipSistemi.Models.InternshipDiary
@using WebTabanliStajTakipSistemi.Models

@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Yeni Defter Kaydı";
    var activeInternship = ViewBag.ActiveInternship as Internship;
}

<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<style>
    .diary-wrap {
        background: linear-gradient(180deg, #eef5ff 0%, #f8fbff 100%);
        border-radius: 28px;
        padding: 24px;
    }

    .diary-hero {
        background: linear-gradient(135deg, #0f5bd7, #2b82fb 55%, #69a8ff);
        color: #fff;
        border-radius: 28px;
        padding: 32px;
        box-shadow: 0 20px 40px rgba(43, 130, 251, .25);
        margin-bottom: 24px;
    }

    .glass-card {
        background: rgba(255,255,255,.96);
        border: 1px solid #d9e7ff;
        border-radius: 24px;
        box-shadow: 0 12px 28px rgba(15, 91, 215, .08);
    }

    .mini-label {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #5f77a1;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 52px;
        border-radius: 16px;
        border: 1px solid #d5e4ff;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 .2rem rgba(59,130,246,.12);
        }

    .internship-box {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        border: 1px solid #d5e4ff;
        border-radius: 18px;
        padding: 18px 20px;
    }

    .internship-title {
        font-size: 15px;
        font-weight: 700;
        color: #123d82;
    }

    .internship-sub {
        font-size: 13px;
        color: #5b6c8d;
    }

    .editor-shell {
        overflow: visible;
        border-radius: 20px;
        border: 1px solid #d5e4ff;
        background: #fff;
        box-shadow: 0 8px 22px rgba(15, 91, 215, .06);
    }

    .ql-toolbar.ql-snow {
        border: none !important;
        background: linear-gradient(180deg, #f8fbff 0%, #eef5ff 100%);
        padding: 14px 16px;
        border-radius: 20px 20px 0 0;
    }

    .ql-container.ql-snow {
        border: none !important;
        font-size: 15px;
        border-radius: 0 0 20px 20px;
    }

    .ql-editor {
        min-height: 500px;
        line-height: 1.9;
        color: #22324b;
        padding: 22px;
    }

        .ql-editor.ql-blank::before {
            color: #94a3b8;
            font-style: normal;
        }

        .ql-editor img {
            max-width: 100%;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
            margin: 12px 0;
            cursor: pointer;
        }

    .tip-box {
        background: #edf5ff;
        border: 1px solid #d5e4ff;
        border-radius: 18px;
        padding: 16px;
        color: #35588e;
    }

    .ql-snow .ql-picker {
        color: #243b64;
    }

    .ql-snow .ql-stroke {
        stroke: #35588e;
    }

    .ql-snow .ql-fill {
        fill: #35588e;
    }

    .ql-snow button:hover .ql-stroke,
    .ql-snow button.ql-active .ql-stroke,
    .ql-snow .ql-picker-label:hover .ql-stroke,
    .ql-snow .ql-picker-label.ql-active .ql-stroke {
        stroke: #0f5bd7;
    }

    .ql-snow button:hover .ql-fill,
    .ql-snow button.ql-active .ql-fill,
    .ql-snow .ql-picker-label:hover .ql-fill,
    .ql-snow .ql-picker-label.ql-active .ql-fill {
        fill: #0f5bd7;
    }

    /* Font classları */
    .ql-font-arial {
        font-family: Arial, sans-serif;
    }

    .ql-font-calibri {
        font-family: Calibri, Arial, sans-serif;
    }

    .ql-font-times-new-roman {
        font-family: "Times New Roman", serif;
    }

    .ql-font-georgia {
        font-family: Georgia, serif;
    }

    .ql-font-verdana {
        font-family: Verdana, sans-serif;
    }

    .ql-font-tahoma {
        font-family: Tahoma, sans-serif;
    }

    /* Punto classları */
    .ql-size-12px {
        font-size: 12px;
    }

    .ql-size-14px {
        font-size: 14px;
    }

    .ql-size-16px {
        font-size: 16px;
    }

    .ql-size-18px {
        font-size: 18px;
    }

    .ql-size-20px {
        font-size: 20px;
    }

    .ql-size-24px {
        font-size: 24px;
    }

    .ql-size-28px {
        font-size: 28px;
    }

    /* Quill dropdown genişlikleri */
    .ql-snow .ql-picker.ql-font {
        width: 155px;
    }

    .ql-snow .ql-picker.ql-size {
        width: 80px;
    }

    .ql-snow .ql-picker.ql-header {
        width: 120px;
    }

    /* Font dropdown yazıları */
    .ql-snow .ql-picker.ql-font .ql-picker-label::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item::before {
        content: "Arial";
        font-family: Arial, sans-serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="arial"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="arial"]::before {
        content: "Arial";
        font-family: Arial, sans-serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="calibri"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="calibri"]::before {
        content: "Calibri";
        font-family: Calibri, Arial, sans-serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="times-new-roman"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="times-new-roman"]::before {
        content: "Times New Roman";
        font-family: "Times New Roman", serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="georgia"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="georgia"]::before {
        content: "Georgia";
        font-family: Georgia, serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="verdana"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="verdana"]::before {
        content: "Verdana";
        font-family: Verdana, sans-serif;
    }

    .ql-snow .ql-picker.ql-font .ql-picker-label[data-value="tahoma"]::before,
    .ql-snow .ql-picker.ql-font .ql-picker-item[data-value="tahoma"]::before {
        content: "Tahoma";
        font-family: Tahoma, sans-serif;
    }

    /* Punto dropdown yazıları */
    .ql-snow .ql-picker.ql-size .ql-picker-label::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item::before {
        content: "16";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="12px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="12px"]::before {
        content: "12";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="14px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="14px"]::before {
        content: "14";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="16px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="16px"]::before {
        content: "16";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="18px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="18px"]::before {
        content: "18";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="20px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="20px"]::before {
        content: "20";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="24px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="24px"]::before {
        content: "24";
    }

    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value="28px"]::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value="28px"]::before {
        content: "28";
    }

    /* Başlık dropdown yazıları */
    .ql-snow .ql-picker.ql-header .ql-picker-label::before,
    .ql-snow .ql-picker.ql-header .ql-picker-item::before {
        content: "Normal";
    }

    .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="1"]::before,
    .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="1"]::before {
        content: "Başlık 1";
    }

    .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="2"]::before,
    .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="2"]::before {
        content: "Başlık 2";
    }

    .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="3"]::before,
    .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="3"]::before {
        content: "Başlık 3";
    }

    /* Resim resize overlay */
    .image-resize-overlay {
        position: fixed;
        display: none;
        border: 2px solid #3b82f6;
        z-index: 99999;
        pointer-events: none;
        box-sizing: border-box;
    }

    .image-resize-toolbar {
        position: absolute;
        top: -42px;
        left: 50%;
        transform: translateX(-50%);
        background: #1e40af;
        border-radius: 10px;
        padding: 5px 7px;
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        pointer-events: auto;
        box-shadow: 0 8px 18px rgba(30,64,175,.25);
    }

        .image-resize-toolbar button {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            padding: 4px 8px;
            border-radius: 6px;
            cursor: pointer;
        }

            .image-resize-toolbar button:hover {
                background: rgba(255,255,255,.22);
            }

    .image-size-label {
        color: #bfdbfe;
        font-size: 11px;
        font-weight: 700;
        padding: 0 6px;
    }

    .image-resize-handle {
        width: 11px;
        height: 11px;
        background: #3b82f6;
        border: 2px solid #fff;
        border-radius: 50%;
        position: absolute;
        pointer-events: auto;
    }

        .image-resize-handle.nw {
            top: -6px;
            left: -6px;
            cursor: nwse-resize;
        }

        .image-resize-handle.ne {
            top: -6px;
            right: -6px;
            cursor: nesw-resize;
        }

        .image-resize-handle.sw {
            bottom: -6px;
            left: -6px;
            cursor: nesw-resize;
        }

        .image-resize-handle.se {
            bottom: -6px;
            right: -6px;
            cursor: nwse-resize;
        }
</style>

<div class="diary-wrap">
    <div class="diary-hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="small fw-bold text-uppercase mb-2 opacity-75">Staj Defteri</div>
                <h2 class="fw-bold mb-2">Yeni Günlük Kaydı Oluştur</h2>
                <div class="opacity-75">
                    Günlük çalışmanı Word benzeri araçlarla biçimlendir, görsel ekle, boyutlandır ve konumlandır.
                </div>
            </div>
            <div class="badge bg-light text-primary px-3 py-2 rounded-pill">Rich Text Editor</div>
        </div>
    </div>

    <div class="glass-card p-4 p-lg-5">
        <form asp-action="Create" method="post" id="diaryForm">
            @Html.AntiForgeryToken()
            <input asp-for="InternshipId" type="hidden" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="mini-label">Aktif Staj Kaydı</div>
                    <div class="internship-box">
                        <div class="internship-title">
                            @(activeInternship?.Position ?? "Aktif staj bulunamadı")
                        </div>
                        <div class="internship-sub">
                            @(activeInternship?.Company?.Name ?? "Firma bilgisi yok")
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="mini-label">Çalışma Tarihi</div>
                    <input asp-for="WorkDate"
                           type="text"
                           class="form-control diary-date-picker"
                           autocomplete="off"
                           data-min-date="@ViewBag.MinWorkDate"
                           data-max-date="@ViewBag.MaxWorkDate"
                           data-disabled-dates='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DisabledDiaryDates ?? new List<string>()))' />
                    <span asp-validation-for="WorkDate" class="text-danger small d-block mt-1"></span>
                </div>
            </div>

            <div class="mb-4">
                <div class="mini-label">Başlık</div>
                <input asp-for="Title" class="form-control" placeholder="Bugün hangi işi yaptın?" />
                <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-bold fs-5 text-primary">Günlük İçeriği</div>
                    <div class="small text-muted">Font • Punto • Hizalama • Renk • Görsel • Resize</div>
                </div>

                <div class="editor-shell">
                    <div id="editor"></div>
                </div>

                <input type="hidden" asp-for="Content" id="Content" />
                <span asp-validation-for="Content" class="text-danger small d-block mt-2"></span>
            </div>

            <div class="tip-box mt-4">
                <strong>İpucu:</strong> Görsel ekledikten sonra üzerine tıklayarak boyutlandırabilir ve hizalayabilirsin.
                İçerik kaydedildiğinde tüm biçimlendirme aynen saklanır.
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light px-4 rounded-pill">Geri Dön</a>
                <button type="submit" class="btn btn-primary px-4 rounded-pill">
                    <i class="bi bi-save2 me-1"></i> Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>

    <script>
        var Font = Quill.import('formats/font');
        Font.whitelist = [
            'arial',
            'calibri',
            'times-new-roman',
            'georgia',
            'verdana',
            'tahoma'
        ];
        Quill.register(Font, true);

        var Size = Quill.import('attributors/style/size');
        Size.whitelist = [
            '12px',
            '14px',
            '16px',
            '18px',
            '20px',
            '24px',
            '28px'
        ];
        Quill.register(Size, true);

        var quill = null;
        var selectedImg = null;
        var imageOverlay = null;
        var resizeState = null;

        document.addEventListener('DOMContentLoaded', function () {
             initDiaryDatePicker();
            quill = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'İçeriği düzenle...',
                modules: {
                    toolbar: [
                        [{ 'font': ['arial', 'calibri', 'times-new-roman', 'georgia', 'verdana', 'tahoma'] }],
                        [{ 'size': ['12px', '14px', '16px', '18px', '20px', '24px', '28px'] }],
                        [{ 'header': [false, 1, 2, 3] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'align': [] }],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        [{ 'indent': '-1' }, { 'indent': '+1' }],
                        ['blockquote', 'code-block', 'link', 'image'],
                        ['clean']
                    ]
                }
            });

            var toolbar = quill.getModule('toolbar');
            toolbar.addHandler('image', imageHandler);

            addToolbarTooltips();

            quill.root.addEventListener('click', function (e) {
                var img = e.target.closest && e.target.closest('img');

                if (img) {
                    e.preventDefault();
                    e.stopPropagation();
                    selectImage(img);
                }
            });

            quill.root.addEventListener('dblclick', function (e) {
                var img = e.target.closest && e.target.closest('img');

                if (img) {
                    e.preventDefault();
                    e.stopPropagation();
                    selectImage(img);
                }
            });

            document.addEventListener('click', function (e) {
                if (!selectedImg) return;

                var clickedEditor = quill.root.contains(e.target);
                var clickedOverlay = imageOverlay && imageOverlay.contains(e.target);

                if (!clickedEditor && !clickedOverlay) {
                    deselectImage();
                }
            });

            window.addEventListener('resize', updateImageOverlay);
            window.addEventListener('scroll', updateImageOverlay, true);

            document.getElementById('diaryForm').addEventListener('submit', function () {
                deselectImage();
                document.getElementById('Content').value = quill.root.innerHTML;
            });
        });

        function addToolbarTooltips() {
            var titles = {
                'ql-bold': 'Kalın',
                'ql-italic': 'İtalik',
                'ql-underline': 'Altı çizili',
                'ql-strike': 'Üzeri çizili',
                'ql-blockquote': 'Alıntı',
                'ql-code-block': 'Kod bloğu',
                'ql-link': 'Bağlantı ekle',
                'ql-image': 'Görsel ekle',
                'ql-clean': 'Biçimlendirmeyi temizle'
            };

            Object.keys(titles).forEach(function (className) {
                document.querySelectorAll('.ql-toolbar .' + className).forEach(function (el) {
                    el.setAttribute('title', titles[className]);
                });
            });

            document.querySelectorAll('.ql-toolbar .ql-font .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Yazı tipi');
            });

            document.querySelectorAll('.ql-toolbar .ql-size .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Yazı boyutu');
            });

            document.querySelectorAll('.ql-toolbar .ql-header .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Başlık türü');
            });

            document.querySelectorAll('.ql-toolbar .ql-color .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Yazı rengi');
            });

            document.querySelectorAll('.ql-toolbar .ql-background .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Arka plan rengi');
            });

            document.querySelectorAll('.ql-toolbar .ql-align .ql-picker-label').forEach(function (el) {
                el.setAttribute('title', 'Hizalama');
            });

            document.querySelectorAll('.ql-toolbar button[value="+1"]').forEach(function (el) {
                el.setAttribute('title', 'Girintiyi artır');
            });

            document.querySelectorAll('.ql-toolbar button[value="-1"]').forEach(function (el) {
                el.setAttribute('title', 'Girintiyi azalt');
            });

            document.querySelectorAll('.ql-toolbar button[value="ordered"]').forEach(function (el) {
                el.setAttribute('title', 'Numaralı liste');
            });

            document.querySelectorAll('.ql-toolbar button[value="bullet"]').forEach(function (el) {
                el.setAttribute('title', 'Madde işaretli liste');
            });
        }

        function ensureImageOverlay() {
            if (imageOverlay) return;

            imageOverlay = document.createElement('div');
            imageOverlay.className = 'image-resize-overlay';

            imageOverlay.innerHTML =
                '<div class="image-resize-toolbar">' +
                    '<button type="button" data-align="left" title="Resmi sola hizala">Sol</button>' +
                    '<button type="button" data-align="center" title="Resmi ortala">Orta</button>' +
                    '<button type="button" data-align="right" title="Resmi sağa hizala">Sağ</button>' +
                    '<span class="image-size-label" id="imageSizeLabel"></span>' +
                '</div>' +
                '<div class="image-resize-handle nw" data-handle="nw" title="Boyutlandır"></div>' +
                '<div class="image-resize-handle ne" data-handle="ne" title="Boyutlandır"></div>' +
                '<div class="image-resize-handle sw" data-handle="sw" title="Boyutlandır"></div>' +
                '<div class="image-resize-handle se" data-handle="se" title="Boyutlandır"></div>';

            document.body.appendChild(imageOverlay);

            imageOverlay.querySelectorAll('[data-align]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    alignSelectedImage(this.dataset.align);
                });
            });

            imageOverlay.querySelectorAll('[data-handle]').forEach(function (handle) {
                handle.addEventListener('mousedown', startImageResize);
            });
        }

        function selectImage(img) {
            selectedImg = img;

            selectedImg.style.maxWidth = '100%';

            ensureImageOverlay();
            imageOverlay.style.display = 'block';
            updateImageOverlay();
        }

        function deselectImage() {
            if (imageOverlay) {
                imageOverlay.style.display = 'none';
            }

            selectedImg = null;
            resizeState = null;
        }

        function updateImageOverlay() {
            if (!selectedImg || !imageOverlay) return;

            var rect = selectedImg.getBoundingClientRect();

            if (rect.width <= 0 || rect.height <= 0) {
                imageOverlay.style.display = 'none';
                return;
            }

            imageOverlay.style.display = 'block';
            imageOverlay.style.left = rect.left + 'px';
            imageOverlay.style.top = rect.top + 'px';
            imageOverlay.style.width = rect.width + 'px';
            imageOverlay.style.height = rect.height + 'px';

            var label = document.getElementById('imageSizeLabel');
            if (label) {
                label.textContent = Math.round(rect.width) + 'x' + Math.round(rect.height);
            }
        }

        function startImageResize(e) {
            if (!selectedImg) return;

            e.preventDefault();
            e.stopPropagation();

            var handle = e.target.dataset.handle;
            var rect = selectedImg.getBoundingClientRect();

            resizeState = {
                handle: handle,
                startX: e.clientX,
                startY: e.clientY,
                startW: rect.width,
                startH: rect.height,
                ratio: rect.height / rect.width
            };

            document.addEventListener('mousemove', resizeImageMove);
            document.addEventListener('mouseup', stopImageResize);
        }

        function resizeImageMove(e) {
            if (!selectedImg || !resizeState) return;

            var dx = e.clientX - resizeState.startX;
            var handle = resizeState.handle;

            var newW;

            if (handle === 'nw' || handle === 'sw') {
                newW = resizeState.startW - dx;
            } else {
                newW = resizeState.startW + dx;
            }

            newW = Math.max(80, newW);

            selectedImg.style.width = Math.round(newW) + 'px';
            selectedImg.style.height = 'auto';

            updateImageOverlay();
        }

        function stopImageResize() {
            document.removeEventListener('mousemove', resizeImageMove);
            document.removeEventListener('mouseup', stopImageResize);

            resizeState = null;
            updateImageOverlay();
        }

        function alignSelectedImage(dir) {
            if (!selectedImg) return;

            selectedImg.style.float = '';
            selectedImg.style.display = 'block';
            selectedImg.style.marginTop = '12px';
            selectedImg.style.marginBottom = '12px';

            if (dir === 'left') {
                selectedImg.style.float = 'left';
                selectedImg.style.marginLeft = '0';
                selectedImg.style.marginRight = '14px';
            } else if (dir === 'right') {
                selectedImg.style.float = 'right';
                selectedImg.style.marginLeft = '14px';
                selectedImg.style.marginRight = '0';
            } else {
                selectedImg.style.float = 'none';
                selectedImg.style.marginLeft = 'auto';
                selectedImg.style.marginRight = 'auto';
            }

            updateImageOverlay();
        }

        function initDiaryDatePicker() {
            var input = document.querySelector('.diary-date-picker');

            if (!input || typeof flatpickr === 'undefined') {
                return;
            }

            var disabledDates = [];

            try {
                disabledDates = JSON.parse(input.dataset.disabledDates || '[]');
            } catch (e) {
                disabledDates = [];
            }

            flatpickr(input, {
                dateFormat: 'Y-m-d',
                altInput: true,
                altFormat: 'd.m.Y',
                locale: 'tr',
                minDate: input.dataset.minDate || null,
                maxDate: input.dataset.maxDate || null,
                disable: disabledDates,
                allowInput: false
            });
        }

        function imageHandler() {
            var input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = function () {
                var file = input.files[0];
                if (!file) return;

                var formData = new FormData();
                formData.append('file', file);

                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';

                fetch('@Url.Action("UploadEditorImage", "InternshipDiary")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token
                    }
                })
                .then(function (r) {
                    return r.json();
                })
                .then(function (result) {
                    if (!result.url) {
                        alert(result.error || 'Görsel yüklenemedi.');
                        return;
                    }

                    var range = quill.getSelection(true);

                    quill.insertEmbed(range.index, 'image', result.url, 'user');
                    quill.setSelection(range.index + 1, 0, 'silent');

                    setTimeout(function () {
                        var imgs = quill.root.querySelectorAll('img');
                        var lastImg = imgs[imgs.length - 1];

                        if (lastImg) {
                            selectImage(lastImg);
                        }
                    }, 120);
                })
                .catch(function () {
                    alert('Görsel yüklenirken hata oluştu.');
                });
            };
        }
    </script>
}