<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --admin-bg: #1a2236; /* Daha koyu, profesyonel lacivert */
            --admin-accent: #3b82f6;
        }

        body {
            background-color: #f3f4f6;
            overflow-x: hidden;
        }

        #admin-sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            background: var(--admin-bg);
            color: #fff;
            z-index: 1000;
        }

            #admin-sidebar .nav-link {
                color: #9ca3af;
                padding: 12px 25px;
                font-size: 14px;
                transition: 0.3s;
                border-left: 4px solid transparent;
            }

                #admin-sidebar .nav-link:hover, #admin-sidebar .nav-link.active {
                    color: #fff;
                    background: #1f2937;
                    border-left: 4px solid var(--admin-accent);
                }

        #admin-content {
            padding-left: 260px;
            width: 100%;
            min-height: 100vh;
        }

        .admin-navbar {
            background: #fff;
            padding: 15px 30px;
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 999;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <nav id="admin-sidebar">
            <div class="p-4 text-center border-bottom border-secondary">
                <h5 class="fw-bold m-0 text-white">ISUBÜ ADMIN</h5>
                <small class="text-muted">Staj Yönetim Sistemi</small>
            </div>
            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")"
                       asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>

                <li class="px-4 small text-muted text-uppercase mt-4 mb-2" style="font-size: 11px; font-weight: 700;">Kullanıcı Yönetimi</li>
                <li><a class="nav-link" asp-controller="Admin" asp-action="Students"><i class="bi bi-people-fill me-2"></i> Öğrenciler</a></li>
                <li><a class="nav-link" asp-controller="Admin" asp-action="Teachers"><i class="bi bi-person-badge-fill me-2"></i> Akademisyenler</a></li>
                <li><a class="nav-link" asp-controller="Admin" asp-action="Admins"><i class="bi bi-shield-lock-fill me-2"></i> Yöneticiler</a></li>

                <li class="px-4 small text-muted text-uppercase mt-4 mb-2" style="font-size: 11px; font-weight: 700;">Kurumsal Yapı</li>
                <li><a class="nav-link" asp-controller="University" asp-action="Index"><i class="bi bi-mortarboard-fill me-2"></i> Üniversiteler</a></li>
                <li><a class="nav-link" asp-controller="Department" asp-action="Index"><i class="bi bi-diagram-3-fill me-2"></i> Bölümler</a></li>
                <li><a class="nav-link" asp-controller="Admin" asp-action="Companies"><i class="bi bi-building-fill me-2"></i> Firmalar</a></li>
                <li><a class="nav-link" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear-fill me-2"></i> Sistem Ayarları </a></li>

                <li class="mt-5 border-top border-secondary pt-3">
                    <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Güvenli Çıkış
                    </a>
                </li>
            </ul>
        </nav>

        <div id="admin-content">
            <nav class="admin-navbar d-flex justify-content-between align-items-center shadow-sm">
                <div class="fw-bold text-secondary">
                    <span class="text-muted fw-normal">Yönetim Masası /</span> @ViewData["Title"]
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none p-0 border-0 dropdown-toggle d-flex align-items-center"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <div class="text-end me-3">
                            <div class="small fw-bold text-dark">@User.Identity.Name</div>
                            <span class="badge bg-danger" style="font-size: 10px;">Sistem Yöneticisi</span>
                        </div>
                        <i class="bi bi-person-circle fs-3 text-secondary"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Profile">
                                <i class="bi bi-person me-2 text-primary"></i> Profilim
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-controller="Admin" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>