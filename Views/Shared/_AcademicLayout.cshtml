<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akademisyen Paneli - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --academic-bg: #2b1f4a;
            --academic-bg-soft: #36265e;
            --academic-accent: #8b5cf6;
            --academic-accent-2: #a78bfa;
            --academic-surface: #f5f7fb;
        }

        body {
            background-color: var(--academic-surface);
            overflow-x: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        #academic-sidebar {
            width: 270px;
            height: 100vh;
            position: fixed;
            background: linear-gradient(180deg, var(--academic-bg) 0%, #24183f 100%);
            color: #fff;
            z-index: 1000;
            box-shadow: 8px 0 30px rgba(0,0,0,0.08);
        }

            #academic-sidebar .brand-box {
                padding: 24px 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.08);
                background: rgba(255,255,255,0.03);
            }

            #academic-sidebar .brand-title {
                font-weight: 800;
                font-size: 20px;
                color: #fff;
                letter-spacing: .3px;
            }

            #academic-sidebar .brand-subtitle {
                color: #c4b5fd;
                font-size: 12px;
                margin-top: 4px;
            }

            #academic-sidebar .nav-link {
                color: #cbd5e1;
                padding: 12px 22px;
                margin: 4px 12px;
                border-radius: 14px;
                font-size: 14px;
                font-weight: 600;
                transition: all .25s ease;
                border-left: 4px solid transparent;
            }

                #academic-sidebar .nav-link:hover {
                    color: #fff;
                    background: rgba(255,255,255,0.08);
                    border-left: 4px solid var(--academic-accent);
                }

                #academic-sidebar .nav-link.active {
                    color: #fff;
                    background: linear-gradient(90deg, rgba(139,92,246,.22), rgba(167,139,250,.12));
                    border-left: 4px solid var(--academic-accent);
                    box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
                }

        #academic-content {
            padding-left: 270px;
            width: 100%;
            min-height: 100vh;
        }

        .academic-navbar {
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(8px);
            padding: 16px 30px;
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 999;
        }

            .academic-navbar .page-title {
                color: #374151;
                font-weight: 800;
            }

                .academic-navbar .page-title span {
                    color: #9ca3af;
                    font-weight: 500;
                }

        .dropdown-toggle::after {
            margin-left: 10px;
        }

        .profile-btn {
            background: transparent;
            border: 0;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

            .profile-btn:hover {
                opacity: .9;
            }

        .section-caption {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .7px;
            text-transform: uppercase;
            color: #a78bfa;
            padding: 0 24px;
            margin-top: 22px;
            margin-bottom: 8px;
        }

        .dropdown-menu {
            border-radius: 16px;
            overflow: hidden;
        }

        .dropdown-item {
            font-weight: 600;
            padding: 10px 14px;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <nav id="academic-sidebar">
            <div class="brand-box">
                <div class="brand-title">AKADEMİSYEN PANELİ</div>
                <div class="brand-subtitle">Staj Takip Sistemi</div>
            </div>

            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Academic" ? "active" : "")"
                       asp-controller="Academic" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Anasayfa
                    </a>
                </li>

                <li class="section-caption">Staj Yönetimi</li>

                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PendingApprovals" ? "active" : "")"
                       asp-controller="Internship" asp-action="PendingApprovals">
                        <i class="bi bi-hourglass-split me-2"></i> Bekleyen Onaylar
                    </a>
                </li>

                <li>
                    <a class="nav-link"
                       asp-controller="Academic" asp-action="ActiveInternships">
                        <i class="bi bi-briefcase-fill me-2"></i> Aktif Stajlar
                    </a>
                </li>

                <li>
                    <a class="nav-link"
                       asp-controller="Academic" asp-action="DiaryReviews">
                        <i class="bi bi-journal-check me-2"></i> Günlük İncelemeleri
                    </a>
                </li>

                <li class="section-caption">Hesap</li>

                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")"
                       asp-controller="Academic" asp-action="Profile">
                        <i class="bi bi-person-circle me-2"></i> Profilim
                    </a>
                </li>

                <li class="mt-5 pt-3 border-top border-light border-opacity-10">
                    <a class="nav-link text-danger fw-bold"
                       asp-controller="Academic" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Güvenli Çıkış
                    </a>
                </li>
            </ul>
        </nav>

        <div id="academic-content">
            <nav class="academic-navbar d-flex justify-content-between align-items-center shadow-sm">
                <div class="page-title">
                    <span>Akademisyen Paneli /</span> @ViewData["Title"]
                </div>

                <div class="dropdown">
                    <button class="profile-btn dropdown-toggle p-0"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <div class="text-end me-3">
                            <div class="small fw-bold text-dark">@User.Identity?.Name</div>
                            <span class="badge" style="background:#8b5cf6; font-size:10px;">Akademisyen</span>
                        </div>
                        <i class="bi bi-person-circle fs-3 text-secondary"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Academic" asp-action="Profile">
                                <i class="bi bi-person me-2 text-primary"></i> Profilim
                            </a>
                        </li>
                        <li><hr class="dropdown-divider m-0" /></li>
                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-controller="Academic" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>