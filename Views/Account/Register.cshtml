@model WebTabanliStajTakipSistemi.Models.Student

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - Staj Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: radial-gradient(circle at center, #1a2a3a 0%, #0a0f14 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            color: white;
            margin: 0;
            padding: 20px 0;
        }

        .register-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 550px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            color: #333;
            text-align: center;
        }

        .portal-title {
            font-weight: 800;
            font-size: 28px;
            color: #1a2a3a;
            margin-bottom: 5px;
        }

        .sub-text {
            color: #888;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            text-align: left;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 8px;
            color: #555;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ddd;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .btn-register {
            background: #2b82fb;
            border: none;
            padding: 12px;
            font-weight: 700;
            border-radius: 8px;
            width: 100%;
            color: white;
            transition: 0.3s;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(43, 130, 251, 0.2);
        }

            .btn-register:hover {
                background: #1a6ada;
                transform: translateY(-1px);
            }

        .footer-links {
            margin-top: 20px;
            font-size: 13px;
        }

            .footer-links a {
                color: #2b82fb;
                text-decoration: none;
                font-weight: 700;
            }
    </style>
</head>
<body>

    <div class="register-card shadow-lg">
        <div class="portal-title">Yeni Hesap Oluştur</div>
        <div class="sub-text">Öğrenci Kayıt Formu</div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="text-start">
                <label class="form-label">Öğrenci Numarası</label>
                <input asp-for="StudentNumber" class="form-control" placeholder="Örn: 2212729004" required />
            </div>

            <div class="text-start">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control" placeholder="Adınız ve Soyadınız" required />
            </div>

            <div class="text-start">
                <label class="form-label">E-posta Adresi</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@isubu.edu.tr" required />
            </div>

            <div class="text-start">
                <label class="form-label">Parola</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
            </div>

            <div class="row">
                <div class="col-md-6 text-start">
                    <label class="form-label text-primary">Üniversite</label>
                    <select asp-for="UniversityId" class="form-select" asp-items="ViewBag.UniversityId" required>
                        <option value="">Üniversite Seçiniz</option>
                    </select>
                </div>
                <div class="col-md-6 text-start">
                    <label class="form-label text-primary">Bölüm</label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId" required>
                        <option value="">Bölüm Seçiniz</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-register">
                <i class="bi bi-person-plus-fill me-2"></i> Kaydı Tamamla
            </button>
        </form>

        <div class="footer-links">
            Zaten bir hesabın var mı? <a asp-action="Login">Giriş Yap</a>
        </div>
    </div>
</body>
</html>